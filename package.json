  ],
  "license": "MIT",
  "main": "n/a",
  "scripts": {
    "clean": "gatsby clean",
    "start": "npm run develop",
    "build": "gatsby clean && gatsby build --prefix-paths",
    "develop": "gatsby clean && gatsby develop",
    "format": "prettier --trailing-comma es5 --no-semi --single-quote --write \"{gatsby-*.js,src/**/*.js}\"",
    "package update w/o ncu -u": "rm -rf node_modules yarn.lock package.lock && npm install && npm run build",
    "npm package update": "ncu -u && rm -rf node_modules yarn.lock package.lock && npm install && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">= 20.18.0"
  }
}
